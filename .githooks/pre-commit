#
#  Lint the Swift sources locally with SwiftLint so style issues are caught
#  before they reach CI. Run once from `scripts/install-hooks.sh` to activate.
#

set -euo pipefail

# Work from the repository root so the whole project is linted, matching CI.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${SCRIPT_DIR}/.."

if ! command -v swiftlint >/dev/null 2>&1; then
    echo "==> swiftlint not found on PATH."
    echo "==> Install it with: brew install swiftlint  (see README, 'Development -> Linting')"
    exit 1
fi

echo "==> Linting with SwiftLint (--strict)…"
swiftlint lint --strict
echo "==> SwiftLint passed."
